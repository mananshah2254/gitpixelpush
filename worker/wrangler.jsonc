{
  // GitPixelPush: one Worker serves the static site and the OAuth exchange.
  // Deploy:   npx wrangler deploy
  // Secret:   npx wrangler secret put GITHUB_CLIENT_SECRET
  "name": "gitpixelpush",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../site"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Re-enable once the Cloudflare dashboard shows this zone as "Active"
  // (nameserver propagation after a registrar switch takes a while):
  // "routes": [{ "pattern": "gitpixelpush.com", "custom_domain": true }],
  "vars": {
    // Public identifier of your GitHub OAuth App (not secret).
    "GITHUB_CLIENT_ID": "YOUR_GITHUB_OAUTH_CLIENT_ID",
    // Extra cross-origin callers allowed on /exchange (same-origin always works).
    "ALLOWED_ORIGINS": "http://localhost:8787"
  }
}
